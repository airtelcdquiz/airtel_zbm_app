# ---------------------------------------------------------------------------
# Dashboard Airtel Quiz ZBM — variables d'environnement
#
# Déploiement (Dokploy) : renseigner ces variables dans l'interface Dokploy,
# ou placer un `.env` à côté de ce fichier. `docker-compose.yml` les transmet
# au conteneur via son bloc `environment:`.
#
# Développement local (`npm run dev`) : copier ce fichier en `app/.env`,
# que Next.js charge automatiquement.
# ---------------------------------------------------------------------------

# API backend (airtel_zbm_api), préfixe /api inclus.
# Variable NEXT_PUBLIC_* : inlinée dans le bundle client au `yarn build`, elle
# doit donc être présente AU BUILD, pas seulement au démarrage.
NEXT_PUBLIC_API_BASE_URL=https://question-worker-api.airtelquiz.com/api

# Base MySQL lue directement par le dashboard (tables `sessions`, `userLogins`).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Secret de signature/vérification des JWT de session.
JWT_SECRET=

# Redis des files d'attente SMS (Bull / BullMQ).
REDIS_URL=redis://ussd-redis:6379

# Passerelle SMPP Airtel (envoi de SMS direct).
SMPP_HOST=messaging.airtel.cd
SMPP_PORT=9001
SMPP_SYSTEM_ID=AirtelQuiz
SMPP_PASSWORD=
